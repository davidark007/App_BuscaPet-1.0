# Copie este arquivo para .env e ajuste para a sua maquina.

# Backend
APP_HOST=0.0.0.0
PORT=3000

# Token que o ESP32/SIM800L precisa enviar para gravar localizacao.
# Gere um valor forte e envie no header X-BuscaPet-Token ou como Bearer token.
BUSCAPET_DEVICE_TOKEN=troque_por_um_token_forte_do_rastreador

# Opcional: id_pet usado quando o rastreador nao enviar id_pet no JSON.
BUSCAPET_DEFAULT_PET_ID=

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=
DB_NAME=busca_pet

# Chave AES-256-GCM usada para proteger dados sensiveis do tutor.
# Use 32 bytes em base64 ou 64 caracteres hex. Nao troque depois de ter dados criptografados.
TUTOR_DATA_KEY=troque_por_uma_chave_base64_de_32_bytes

# HTTPS local. Os scripts Python preenchem esses caminhos automaticamente quando geram certificados.
SSL_KEY_PATH=
SSL_CERT_PATH=

# Frontend
FRONTEND_PORT=3001
VITE_API_PORT=3000
VITE_API_BASE_URL=

# Email para recuperacao de senha. Sem SMTP_HOST, o codigo aparece no terminal do backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Opcional: IP que o app mobile/Expo deve anunciar.
# Use para VPN/Tailscale, por exemplo: BUSCAPET_MOBILE_HOST=100.120.203.85
BUSCAPET_MOBILE_HOST=
